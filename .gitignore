# Compiler files
cache/
out/

# Foundry coverage
lcov.info
coverage/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Addresses persisted between the two Sepolia demo scripts (local artifact, no secrets,
# but regenerated on every deploy, so there is no point versioning it)
script/output/

# Dotenv file: secrets are never versioned
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# Local Claude Code config (e.g. includeCoAuthoredBy): per machine, never
# versioned; see CLAUDE.md, "Git / GitHub", for the exact content to recreate.
/.claude/*
!/.claude/settings.json
