# Copie para .env (NUNCA versionar .env — já está no .gitignore) e preencha com valores reais.
# Todas as chaves privadas aqui devem ser de carteiras BURNER dedicadas a esta testnet —
# nunca uma chave que já tocou mainnet ou guarda fundos reais. Ver secao 0 do prompt de demo.

# RPC de Sepolia (Alchemy/Infura/endpoint publico)
RPC_URL=

# Chave de API do Etherscan, para `--verify`
ETHERSCAN_API_KEY=

# Chave privada da carteira deployer/admin/agente (burner, financiada via faucet)
PRIVATE_KEY=0x

# Chaves privadas dos dois investidores de demo (burner, financiadas via faucet)
INVESTIDOR1_PRIVATE_KEY=0x
INVESTIDOR2_PRIVATE_KEY=0x

# Carteira que recebe os recursos liberados ao emissor (pode ser burner distinta da deployer)
EMISSOR_WALLET_ADDRESS=0x

# Carteira de protocolo (taxa dormente = 0 nesta demo, mas o endereco ainda e' exigido pelo contrato)
PROTOCOLO_WALLET_ADDRESS=0x
