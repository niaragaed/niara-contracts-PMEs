# Copy to .env (NEVER version .env; it is already in .gitignore) and fill in real values.
# Every private key here must belong to a BURNER wallet dedicated to this testnet,
# never a key that has touched mainnet or holds real funds. See section 0 of the demo prompt.

# RPC de Sepolia (Alchemy/Infura/endpoint publico)
RPC_URL=

# Etherscan API key, for `--verify`
ETHERSCAN_API_KEY=

# Private key of the deployer/admin/agent wallet (burner, funded via faucet)
PRIVATE_KEY=0x

# Private keys of the two demo investors (burner, funded via faucet)
INVESTIDOR1_PRIVATE_KEY=0x
INVESTIDOR2_PRIVATE_KEY=0x

# Wallet that receives the funds released to the issuer (can be a burner distinct from the deployer)
EMISSOR_WALLET_ADDRESS=0x

# Protocol wallet (fee is dormant = 0 in this demo, but the contract still requires the address)
PROTOCOLO_WALLET_ADDRESS=0x
